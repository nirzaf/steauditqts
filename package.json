{
  "name": "auditflow-workflow-demonstrator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "api:dev": "wrangler dev --config wrangler.jsonc",
    "db:migrate:local": "wrangler d1 execute quadrate-db --local --file worker/schema.sql",
    "db:migrate:remote": "wrangler d1 execute quadrate-db --remote --file worker/schema.sql",
    "db:migrate:client-safe": "node scripts/apply-client-safe-migration.mjs"
  },
  "dependencies": {
    "canonicalize": "^5.0.0",
    "decimal.js": "^10.6.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "vite": "^6.1.0",
    "wrangler": "^4.131.1"
  }
}
